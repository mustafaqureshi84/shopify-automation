// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A product as it exists in Shopify, mirrored locally.
model Product {
  gid            String  @id
  shopDomain     String
  handle         String
  title          String
  status         String
  totalInventory Int?

  /// Set when a sync run no longer sees this product. Deletion in Shopify
  /// produces no event — absence from a full snapshot is the only signal.
  deletedAt DateTime?

  /// The sync run that last touched this row, for change detection.
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  variants Variant[]

  @@index([shopDomain, status])
  @@index([deletedAt])
  @@index([lastSeenAt])
}

/// A product variant. SKU is deliberately NOT unique — Shopify does not
/// enforce SKU uniqueness, and a constraint here would reject valid data.
model Variant {
  gid             String   @id
  productGid      String
  shopDomain      String
  sku             String?
  price           Decimal? @db.Decimal(12, 2)
  inventoryItemId String?

  deletedAt  DateTime?
  lastSeenAt DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product Product @relation(fields: [productGid], references: [gid], onDelete: Cascade)

  @@index([productGid])
  @@index([sku])
  @@index([shopDomain])
}

/// One row per sync execution.
model SyncRun {
  id         String    @id @default(uuid())
  shopDomain String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running")

  productsSeen      Int @default(0)
  productsCreated   Int @default(0)
  productsUpdated   Int @default(0)
  productsUnchanged Int @default(0)
  productsDeleted   Int @default(0)
  variantsSeen      Int @default(0)

  error String?

  @@index([shopDomain, startedAt])
}

/// Records which webhook events have been fully processed.
///
/// Queue-level deduplication stops duplicate *jobs*. This stops duplicate
/// *work* when a single job is retried after a partial failure, reclaimed
/// from a crashed worker, or run concurrently after a lock expires.
///
/// The row is written in the same transaction as the work it guards, so a
/// crash leaves both or neither. Writing it first risks marking an event
/// done that never happened; writing it after risks repeating work already
/// performed.
model ProcessedEvent {
  /// Shopify's X-Shopify-Webhook-Id. Stable across redeliveries.
  webhookId  String   @id
  topic      String
  shopDomain String
  processedAt DateTime @default(now())

  /// What the handler actually did, for auditing a replay.
  summary String?

  @@index([topic, processedAt])
}

/// Stands in for an external system — a 3PL, ERP, or marketplace.
///
/// A real one would be an HTTP call, which no database transaction can
/// cover. That is the case where the remote operation must be idempotent
/// on its own, or accept an idempotency key.
model WarehouseNotification {
  id         String   @id @default(uuid())
  productGid String
  title      String
  reason     String
  sentAt     DateTime @default(now())

  @@index([productGid, sentAt])
}