// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A product as it exists in Shopify, mirrored locally.
model Product {
  gid            String  @id
  shopDomain     String
  handle         String
  title          String
  status         String
  totalInventory Int?

  deletedAt  DateTime?
  lastSeenAt DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  variants Variant[]

  @@index([shopDomain, status])
  @@index([deletedAt])
  @@index([lastSeenAt])
}

/// A product variant. SKU is deliberately NOT unique — Shopify does not
/// enforce SKU uniqueness, and a constraint here would reject valid data.
model Variant {
  gid             String   @id
  productGid      String
  shopDomain      String
  sku             String?
  price           Decimal? @db.Decimal(12, 2)
  inventoryItemId String?

  deletedAt  DateTime?
  lastSeenAt DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product Product @relation(fields: [productGid], references: [gid], onDelete: Cascade)

  @@index([productGid])
  @@index([sku])
  @@index([shopDomain])
}

/// One row per sync execution.
model SyncRun {
  id         String    @id @default(uuid())
  shopDomain String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running")

  productsSeen      Int @default(0)
  productsCreated   Int @default(0)
  productsUpdated   Int @default(0)
  productsUnchanged Int @default(0)
  productsDeleted   Int @default(0)
  variantsSeen      Int @default(0)

  error String?

  @@index([shopDomain, startedAt])
}

/// Records which webhook events have been fully processed.
model ProcessedEvent {
  webhookId   String   @id
  topic       String
  shopDomain  String
  processedAt DateTime @default(now())
  summary     String?

  @@index([topic, processedAt])
}

/// Stands in for an external system in the product handler.
model WarehouseNotification {
  id         String   @id @default(uuid())
  productGid String
  title      String
  reason     String
  sentAt     DateTime @default(now())

  @@index([productGid, sentAt])
}

/// An order as it exists in Shopify, mirrored locally.
model Order {
  gid         String @id
  shopDomain  String
  orderNumber String

  /// Shopify's financial and fulfillment states are independent — an order
  /// can be paid and unfulfilled, or fulfilled and refunded.
  financialStatus    String?
  fulfillmentStatus  String?

  totalPrice    Decimal @db.Decimal(12, 2)
  currencyCode  String
  customerEmail String?

  /// Whether the order was placed with a test gateway. Real integrations
  /// must not push test orders to a live ERP.
  test Boolean @default(false)

  shopifyCreatedAt DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lineItems OrderLineItem[]
  erpPushes ErpPush[]

  @@index([shopDomain, shopifyCreatedAt])
  @@index([financialStatus])
}

/// A line item. `variantGid` is nullable on purpose: a variant deleted after
/// the order was placed leaves the line item intact but unlinked.
model OrderLineItem {
  gid        String  @id
  orderGid   String
  variantGid String?
  sku        String?
  title      String
  quantity   Int
  price      Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderGid], references: [gid], onDelete: Cascade)

  @@index([orderGid])
  @@index([sku])
}

/// Tracks an attempt to push an order to the external ERP.
///
/// Written BEFORE the HTTP call and updated after, because no transaction
/// can span a database and someone else's API. A row stuck in `attempting`
/// means the outcome is genuinely unknown — the call may have succeeded with
/// the response lost — and needs reconciliation rather than a blind retry.
model ErpPush {
  id       String @id @default(uuid())
  orderGid String

  /// Sent to the ERP so it can deduplicate. Derived from the order GID and
  /// attempt, NOT random — a random key on every retry defeats the purpose.
  idempotencyKey String @unique

  /// attempting | confirmed | failed | unknown
  status String @default("attempting")

  attempt      Int       @default(1)
  erpReference String?
  error        String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  order Order @relation(fields: [orderGid], references: [gid], onDelete: Cascade)

  @@index([orderGid, status])
  @@index([status, startedAt])
}